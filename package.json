  },
  "directories": {
    "test": "test"
  },
  "files": [
    "bin",
    "dist-server",
    "dist-web",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/main.ts --port 4318\"",
    "build": "bun run typecheck && bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "tsup",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "start": "node bin/claude-dash.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "preview": "vite preview",
    "prepublishOnly": "bun run build"
  },
