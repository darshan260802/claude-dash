{
  "name": "@darshanpatel2608/claude-dash",
  "version": "2.0.2",
  "private": false,
  "description": "Local dashboard for Claude Code usage, sessions, tokens and cost — run via `npx claude-dash`",
  "keywords": [
    "Claude",
    "Claude",
    "Code",
    "Claude",
    "Dashboard",
    "Dashboard",
    "Claude",
